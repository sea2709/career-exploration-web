---
import MotAvatar from '../components/MotAvatar';
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;

const links = [
	{ href: '/quiz', label: 'Interest Quiz' },
	{ href: '/explore', label: 'Career Explorer' },
	{ href: '/interview', label: 'Mock Interview' },
];
const current = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Outfit:wght@500;600;700&family=Nunito+Sans:wght@400;600;700&display=swap"
		/>
		<meta name="theme-color" content="#f4f3fa" />
		<meta name="generator" content={Astro.generator} />
		<title>{title} — Mot</title>
	</head>

	<body class="flex h-dvh flex-col">
		<header>
			<div class="mx-auto flex max-w-[1120px] flex-wrap items-center justify-between gap-4 px-6 py-4">
				<a href="/" class="flex min-h-11 items-center gap-2.5 text-ink no-underline hover:text-ink">
					<MotAvatar />
					<span class="font-display text-[26px] font-bold tracking-[-0.01em]">Mot</span>
				</a>
				<nav aria-label="Tools" class="flex flex-wrap items-center gap-1">
					{
						links.map(({ href, label }) => (
							<a
								href={href}
								aria-current={current === href ? 'page' : undefined}
								class="rounded-full px-3 py-2.5 text-[15px] font-semibold text-ink-muted hover:text-accent aria-[current=page]:text-accent"
							>
								{label}
							</a>
						))
					}
					<span
						class="ml-2 rounded-full border border-line bg-white px-3 py-1.5 text-[13px] font-semibold text-ink-muted"
					>
						Powered by O*NET 31.0
					</span>
				</nav>
			</div>
		</header>
		<main class="min-h-0 flex-1">
			<slot />
		</main>
	</body>
</html>
