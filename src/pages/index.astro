---
import MotAvatar from '../components/MotAvatar';
import AppLayout from '../layouts/AppLayout.astro';

const features = [
	{
		title: 'Take the Interest Quiz',
		href: '/quiz',
		pitch: 'Find which kinds of work you actually enjoy.',
	},
	{
		title: 'Explore careers',
		href: '/explore',
		pitch: 'Ask me about any job, then save and compare favorites.',
	},
	{
		title: 'Practice an interview',
		href: '/interview',
		pitch: 'Rehearse with feedback tied to the job.',
	},
];

const bubble = 'rounded-[22px] border border-line bg-white px-[18px] py-3.5 shadow-bubble';
---

<AppLayout title="Your career assistant">
	<div class="flex h-full flex-col overflow-y-auto">
		<div class="mx-auto flex w-full max-w-[780px] grow flex-col gap-[22px] px-5 pt-8 pb-7">
			<header class="flex flex-col items-center gap-3.5 pt-2 pb-[22px] text-center">
				<MotAvatar size="lg" animated />
				<h1 class="font-display text-[34px]/[1.1] font-semibold tracking-[-0.01em] sm:text-[46px]/[1.1]">
					Hi, I'm Mot, your <span class="text-accent">career</span> assistant
				</h1>
				<p class="max-w-[540px] text-[17px] text-ink-muted">
					I help you find, understand, and prepare for a career, using real occupational data instead of
					guesswork.
				</p>
			</header>

			<div class="flex items-start gap-3">
				<MotAvatar />
				<div class="flex min-w-0 grow flex-col gap-2.5">
					<div class="text-[13px] font-bold">Mot</div>
					<div class:list={[bubble, 'rounded-tl-md']}>
						<p>
							Hi there! Everything I tell you comes from the <a
								href="https://www.onetcenter.org/overview.html">O*NET database</a
							>, the U.S. Department of Labor's main source of occupational information, covering more than
							a thousand occupations.
						</p>
					</div>
					<div class={bubble}>
						<p>What can I help you with today?</p>
					</div>
					<ul class="grid grid-cols-[repeat(auto-fit,minmax(190px,1fr))] gap-3 pt-1">
						{
							features.map(({ title, href, pitch }) => (
								<li class="flex">
									<a
										href={href}
										class="flex min-h-11 grow flex-col gap-1.5 rounded-[18px] border border-line bg-white p-4 text-ink no-underline transition-colors hover:border-accent hover:text-ink"
									>
										<span class="font-display text-lg/[1.25] font-semibold">{title}</span>
										<span class="text-sm text-ink-muted">{pitch}</span>
									</a>
								</li>
							))
						}
					</ul>
				</div>
			</div>
		</div>

		<footer class="border-t border-line">
			<div class="mx-auto max-w-[780px] px-5 pt-5 pb-7">
				<p class="text-xs/normal text-ink-muted">
					This site includes information from the <a href="https://www.onetcenter.org/database.html"
						>O*NET 31.0 Database</a
					> by the U.S. Department of Labor, Employment and Training Administration (USDOL/ETA). Used under the <a
						href="https://creativecommons.org/licenses/by/4.0/">CC BY 4.0</a
					> license. O*NET® is a trademark of USDOL/ETA. USDOL/ETA has not approved, endorsed, or tested these
					tools.
				</p>
			</div>
		</footer>
	</div>
</AppLayout>
